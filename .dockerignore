# Allow only the application and the exact inference assets into the build.
**
!Dockerfile
!requirements-docker.txt
!cafe_ml/
!cafe_ml/*.py
!web/
!web/package.json
!web/pnpm-lock.yaml
!web/index.html
!web/vite.config.js
!web/src/
!web/src/**
!deploy/
!deploy/verify_models.py
!deploy/model_assets.json
!experimentos/
!experimentos/detector_01/
!experimentos/detector_01/weights/
!experimentos/detector_01/weights/best.pt
!experimentos/finetune_01/
!experimentos/finetune_01/efficientnet_b0/
!experimentos/finetune_01/efficientnet_b0/checkpoint.pt
!experimentos/finetune_01/swin_t/
!experimentos/finetune_01/swin_t/checkpoint.pt
!experimentos/transfer_01/
!experimentos/transfer_01/resnet50/
!experimentos/transfer_01/resnet50/checkpoint.pt
!experimentos/transfer_01/densenet121/
!experimentos/transfer_01/densenet121/checkpoint.pt
!experimentos/transfer_01/vit_b_16/
!experimentos/transfer_01/vit_b_16/checkpoint.pt
!.cache/
!.cache/torch/
!.cache/torch/hub/
!.cache/torch/hub/checkpoints/
!.cache/torch/hub/checkpoints/resnet50-11ad3fa6.pth
!.cache/torch/hub/checkpoints/densenet121-a639ec97.pth
!.cache/torch/hub/checkpoints/vit_b_16-c867db91.pth
!pruebas/
!pruebas/camara/
!pruebas/camara/demo_validacion.jpg

# Never import Windows bytecode or local frontend installations into Linux.
**/__pycache__/
**/*.pyc
**/node_modules/
